# Mimir AI Configuration

# Groq API Key for fast LLM inference (or leave blank if using local Ollama)
GROQ_API=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Set to true to force local Ollama (e.g. Qwen2.5 3B)
USE_LOCAL_LLM=false
OLLAMA_MODEL=qwen2.5:3b

# Opt-in OCR for scanned documents & images (requires easyocr)
ENABLE_OCR=false

# Paths
INDEX_DIR=./faiss_index
DB_PATH=./mimir.db
