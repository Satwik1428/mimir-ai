# ==============================================================================
# Mimir AI - Git Ignore Policy
# ==============================================================================

# ─── Secrets, Credentials & Environment Configs ───
.env
.env.local
.env.*.local
*.env
!*.env.example
*.pem
*.key
*.pfx
*.cert
*.crt
credentials.json
service_account.json

# ─── Databases & Local Vector Indices ───
*.db
*.sqlite
*.sqlite3
mimir.db
**/mimir.db
faiss_index/
**/faiss_index/
*.faiss
*.pkl

# ─── User Uploaded & Stored Documents (Private Data) ───
uploaded_docs/
**/uploaded_docs/
uploads/
**/uploads/
storage/
**/storage/

# ─── Test Documents & Test Artifacts ───
testdocs/
**/testdocs/
test_docs/
*test_mimir*.db
*test_faiss*
mimir_test_*
.pytest_cache/
.coverage
htmlcov/

# ─── Python Build, Cache & Virtual Environments ───
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
*.egg

# ─── Frontend & Node Artifacts ───
node_modules/
**/node_modules/
frontend/dist/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# ─── Logs & OS Artifacts ───
*.log
logs/
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── IDE & Editor Configurations ───
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
